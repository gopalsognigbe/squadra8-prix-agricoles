# Copier ce fichier en .env et remplir les secrets en privé.
# Ne jamais commettre le fichier .env (il est ignoré par Git).

# Base de données PostgreSQL 16.
# Dans Docker, l'hôte est « db ». En local (Postgres sur ta machine) : localhost.
DATABASE_URL=postgresql+psycopg://squadra8:squadra8@localhost:5432/prix_agricoles

# ---------------------------------------------------------------------------
# IA principale : Groq (API compatible OpenAI)
# ---------------------------------------------------------------------------
# Clé Groq (préfixe gsk_). GROQ_API_KEY et OPENAI_API_KEY sont interchangeables.
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
# OPENAI_MODEL et LLM_MODEL sont interchangeables.
OPENAI_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# 2e secours : Gemini (API compatible OpenAI), optionnel
# ---------------------------------------------------------------------------
# Si Groq échoue et qu'une clé est présente → Gemini, sinon → règles.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.5-flash-lite

# Secours Azure OpenAI (optionnel).
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini

# Chiffrement du numéro (Fernet) et hash pour les statistiques (HMAC).
# Générer plus tard, partager uniquement en privé.
FERNET_KEY=
HASH_PEPPER=

# Compte initial de la page admin (à changer après la première connexion).
ADMIN_EMAIL=
ADMIN_PASSWORD_INITIAL=
# Clé de signature des cookies admin (générer avec secrets.token_urlsafe(48)).
ADMIN_SESSION_SECRET=

# Touche 3 (question à voix haute). Mettre false si elle n'est pas prête :
# le menu dira « bientôt disponible », les numéros des touches ne changent pas.
QUESTION_VOIX_ACTIVE=false

# Modèle Whisper local (repli) : base est le plus léger ; Groq reste le premier choix.
WHISPER_MODELE=base

# Twilio (bonus, vrais appels). Laisser vide pour le MVP simulateur.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mettre à jour les prix FAO (API publique FPMA) au démarrage, en tâche de fond.
# false = ne rien télécharger au lancement (utile en local ou pour les tests).
MAJ_FAO_AU_DEMARRAGE=true
# true = tous les produits/marchés du Bénin (API Bénin + mondiale). Défaut : MVP seulement.
MAJ_FAO_TOUT_BENIN=false

# Source des prix pour la touche 1. "fao" = fichier data/raw/prix_fao.csv (plan B).
# Plus tard : "base" quand la base de Precious sera prête, sans changer les routes.
SOURCE_PRIX=fao
# Chemin du CSV FAO (défaut : data/raw/prix_fao.csv, rempli au démarrage par maj_fao).
# PRIX_FAO_CSV=data/raw/prix_fao.csv

# Transcription I2 : Groq (Whisper) d'abord ; la clé est GROQ_API_KEY ou OPENAI_API_KEY si la base est Groq.
GROQ_MODELE=whisper-large-v3-turbo
GROQ_TIMEOUT_S=6
AUDIO_MAX_S=8
# Budget total d'une question vocale (transcription + intention), sous les 6 s de G8 :
# passé ce délai, on bascule sur Whisper local puis sur les règles.
IA_DELAI_MAX_S=5.5
# Après un 429 (quota Groq) : un seul réessai, si l'attente demandée ne dépasse pas ce nombre de secondes.
GROQ_REESSAI_MAX_S=1.5
